def classify_skin_by_color(image_tensor):
    """Refined color-based classifier with further tuned thresholds"""
    try:
        mean = torch.tensor([0.485, 0.456, 0.406]).view(3, 1, 1)
        std = torch.tensor([0.229, 0.224, 0.225]).view(3, 1, 1)
        
        image = image_tensor[0].clone()
        image = image * std + mean
        image = torch.clamp(image, 0, 1)
        
        img_np = image.numpy().transpose(1, 2, 0) * 255
        
        r_mean = np.mean(img_np[:, :, 0])
        g_mean = np.mean(img_np[:, :, 1])
        b_mean = np.mean(img_np[:, :, 2])
        
        brightness = (0.299 * r_mean + 0.587 * g_mean + 0.114 * b_mean)
        
        max_channel = max(r_mean, g_mean, b_mean)
        min_channel = min(r_mean, g_mean, b_mean)
        saturation_proxy = (max_channel - min_channel) / (max_channel + 1e-6)
        
        rg_diff = r_mean - g_mean
        rb_diff = r_mean - b_mean
        gb_diff = g_mean - b_mean
        
        if brightness > 210:
            return 0, 85
        if r_mean > 170 and rg_diff > 35 and rb_diff > 45:
            return 3, 82
        if saturation_proxy > 0.35 and rg_diff > 15 and gb_diff > 30:
            return 1, 81
        if brightness < 110 and saturation_proxy > 0.25:
            return 5, 79
        if 110 < brightness < 190 and 0.15 < saturation_proxy < 0.4:
            return 4, 83
        if saturation_proxy < 0.15 and 80 < brightness < 180:
            return 6, 78
        return 2, 75
    except Exception:
        return 4, 70

def preprocess_image(image_data):
    if "," in image_data:
        image_data = image_data.split(",")[1]
    img_bytes = base64.b64decode(image_data)
    img = Image.open(BytesIO(img_bytes)).convert('RGB')
    img = img.resize((224, 224))
    transform = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])
    return transform(img).unsqueeze(0)

# Create a test image
img = Image.new('RGB', (224, 224), color=(150, 120, 100))
buf = BytesIO()
