DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=beauty_clinic
PORT=5000
JWT_SECRET=mochint_secret_key
NODE_ENV=development

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Session Secret
SESSION_SECRET=mochint_session_secret_development_only

# Email Service Configuration (for OTP & Notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=mochintclinic@gmail.com
EMAIL_PASSWORD=dpxbadvautyxfrib

# Appointment Reminder Configuration
# Berapa jam sebelum appointment untuk mengirim reminder (default: 2 jam)
REMINDER_HOURS_BEFORE=2

# Berapa menit interval untuk check pending reminders (default: 10 menit)
# Semakin kecil semakin sering check tapi lebih banyak database queries
REMINDER_CHECK_INTERVAL=10

# Enable/disable reminder service
REMINDER_SERVICE_ENABLED=true

